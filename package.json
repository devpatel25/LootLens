{
  "name": "lootlens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker run -d --name lootlens-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=lootlens -p 5433:5432 postgres:17 || docker start lootlens-pg",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:test:migrate": "NODE_ENV=test prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^30.1.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
