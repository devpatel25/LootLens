# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_APP_URL=
# true only in local dev, CI, and previews. Never in production.
DEMO_MODE=
# local | ci | preview | production. Destructive DB scripts refuse anything but local, ci, preview.
DB_TARGET=
# Production database host. Destructive DB scripts refuse when DATABASE_URL points here.
PROD_DB_HOST=
CRON_SECRET=
